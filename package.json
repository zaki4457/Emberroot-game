{
  "name": "emberroot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Emberroot — The World Remembers. A top-down roguelite action RPG in the browser.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
